@namespace UniversalTables.Components
@implements IAsyncDisposable
@inject IJSRuntime JS
<div @ref="_host" class="ut5-workspace">
@foreach(var window in Controller.Windows)
{
    var top=ReferenceEquals(window,Controller.Windows.LastOrDefault());
    var maximized=_maximized.Contains(window.Id);
    <div @key="window.Id" class="@(maximized ? "ut5-layer ut5-layer-maximized" : "ut5-layer")" data-window="@window.Id" data-active="@(top ? "true" : "false")" inert="@(top ? null : "inert")">
        <div class="ut5-backdrop"></div>
        <section class="ut5-dialog" role="dialog" aria-modal="@(top ? "true" : "false")" aria-label="@window.Title" tabindex="-1" @onkeydown="e=>KeyDown(e,window)">
            <header class="ut5-dialog-header">
                <strong>@window.Title</strong>
                <div class="ut5-dialog-actions">
                    <button type="button" title="@(maximized ? "Восстановить размер" : "Развернуть")" aria-label="@(maximized ? "Восстановить размер" : "Развернуть")" aria-pressed="@(maximized ? "true" : "false")" @onclick="()=>ToggleMaximized(window)"><span aria-hidden="true">@(maximized ? "❐" : "□")</span></button>
                    <button type="button" disabled="@window.Busy" aria-label="Закрыть" @onclick="()=>Close(window)">×</button>
                </div>
            </header>
            <div class="@(window.Kind==WorkspaceWindowKind.Table ? "ut5-dialog-content ut5-dialog-table-content" : "ut5-dialog-content")">
            @switch(window.Kind)
            {
                case WorkspaceWindowKind.Table:
                    if(TableTemplate is not null) { @TableTemplate(window.Table!) }
                    else { <p role="alert">Не задан TableTemplate для дочерних таблиц.</p> }
                    break;
                case WorkspaceWindowKind.Form:
                    <UniversalForm @key="window.Id" Session="window.Form!" Data="Controller.Data" Title="window.Title"
                        BusyChanged="busy=>Controller.SetBusy(window.Id,busy)"
                        Cancelled="()=>Close(window)" Saved="result=>Controller.Complete(window.Id,result)" Notice="Notice" />
                    break;
                case WorkspaceWindowKind.Delete:
                    <DeletionPanel @key="window.Id" Root="window.Entity!.Value" Data="Controller.Data" Restore="window.Restore"
                        BusyChanged="busy=>Controller.SetBusy(window.Id,busy)" Cancelled="()=>Close(window)"
                        Completed="result=>Controller.Complete(window.Id,result)" DependencyRequested="OpenDependency" />
                    break;
                case WorkspaceWindowKind.Recovery:
                    <OperationRecovery />
                    break;
            }
            </div>
        </section>
    </div>
}
</div>
@code {
    [Parameter,EditorRequired] public WorkspaceController Controller {get;set;}=default!;
    [Parameter] public RenderFragment<TableWindowRequest>? TableTemplate {get;set;}
    [Parameter] public EventCallback<TableNotice> Notice {get;set;}
    private WorkspaceController? _subscribed;
    private ElementReference _host;
    private IJSObjectReference? _module,_handle;
    private bool _disposed;
    private readonly HashSet<Guid> _maximized=[];
    protected override void OnParametersSet()
    {
        if(ReferenceEquals(_subscribed,Controller)) return;
        if(_subscribed is not null) _subscribed.Changed-=Changed;
        _maximized.Clear();
        _subscribed=Controller; Controller.Changed+=Changed;
    }
    private void Changed()=>_ = RenderAsync();
    private async Task RenderAsync()
    {
        try { await InvokeAsync(()=>{if(!_disposed) { _maximized.RemoveWhere(id=>!Controller.Windows.Any(window=>window.Id==id)); StateHasChanged(); }}); }
        catch(Exception ex) { if(!_disposed) await DispatchExceptionAsync(ex); }
    }
    private void Close(WorkspaceWindow window)=>Controller.Close(window.Id);
    private void ToggleMaximized(WorkspaceWindow window)
    {
        if(!_maximized.Remove(window.Id)) _maximized.Add(window.Id);
    }
    private void OpenDependency(DependencyGroup group)=>Controller.OpenDependency(group);
    private void KeyDown(KeyboardEventArgs e,WorkspaceWindow window)
    {
        if(e.Key=="Escape") Close(window);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            _module=await JS.InvokeAsync<IJSObjectReference>("import","./_content/UniversalTables/workspace.js");
            _handle=await _module.InvokeAsync<IJSObjectReference>("attach",_host);
        }
        if(_handle is not null) await _handle.InvokeVoidAsync("sync");
    }
    public async ValueTask DisposeAsync()
    {
        _disposed=true;
        if(_subscribed is not null) _subscribed.Changed-=Changed;
        try
        {
            if(_handle is not null) { await _handle.InvokeVoidAsync("dispose"); await _handle.DisposeAsync(); }
            if(_module is not null) await _module.DisposeAsync();
        }
        catch(JSDisconnectedException) { }
    }
}