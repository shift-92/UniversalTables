@namespace UniversalTables.Components
@implements IAsyncDisposable
@inject TableOptions Options
@inject IJSRuntime JS
<div @ref="_root" style="position:relative" @onkeydown="KeyDown" @onkeydown:stopPropagation="true">
    <input class="ut-input" role="combobox" aria-label="@Title" aria-autocomplete="list" aria-expanded="@_open" aria-controls="@_id" aria-activedescendant="@(_active>=0 ? _id+"-"+_active : null)"
        autocomplete="off" disabled="@Disabled" value="@_text" @oninput="InputAsync" @onfocus="Open" @onblur="Close" />
    @if(Clearable && !Disabled) { <button type="button" aria-label="Очистить" @onmousedown:preventDefault="true" @onclick="ClearAsync">×</button> }
    @if(_open && !Disabled)
    {
        <div id="@_id" role="listbox" class="ut-reference-options" style="position:absolute;top:100%;left:0;min-width:100%;max-height:240px;overflow:auto;background:var(--mud-palette-surface,#fff);border:1px solid #888">
            @for(var i=0;i<_items.Length;i++)
            {
                var item=_items[i];
                <div id="@(_id+"-"+i)" role="option" aria-selected="@(i==_active)" class="ut-reference-option" data-ut-tooltip="@(Tooltip is not null ? Tooltip(item) : TooltipText.Format(item.Description ?? item.Label))" @onmousedown:preventDefault="true" @onclick="()=>SelectAsync(item)">@item.Label</div>
            }
            @if(_items.Length==0) { <div role="status">Нет вариантов</div> }
        </div>
    }
</div>
@code {
    [Parameter] public ReferenceOption? Value {get;set;}
    [Parameter] public EventCallback<ReferenceOption?> ValueChanged {get;set;}
    [Parameter,EditorRequired] public Func<IEnumerable<ReferenceOption>> Items {get;set;}=default!;
    [Parameter] public bool Disabled {get;set;}
    [Parameter] public bool Clearable {get;set;}
    [Parameter] public string Title {get;set;}="";
    [Parameter] public Func<ReferenceOption,string?>? Tooltip {get;set;}
    private readonly string _id="ut-reference-"+Guid.NewGuid().ToString("N");
    private ReferenceOption? _previous;
    private ReferenceOption[] _items=[];
    private string _text="";
    private string _query="";
    private bool _open,_disposed;
    private int _active=-1;
    private CancellationTokenSource? _search;
    private ElementReference _root;
    private IJSObjectReference? _module,_tooltipController;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender) return;
        var module=await JS.InvokeAsync<IJSObjectReference>("import","./_content/UniversalTables/table-ui.js");
        if(_disposed) { await module.DisposeAsync(); return; }
        _module=module;
        var controller=await module.InvokeAsync<IJSObjectReference>("attachReferenceTooltip",_root);
        if(_disposed)
        {
            await controller.InvokeVoidAsync("dispose");
            await controller.DisposeAsync();
            return;
        }
        _tooltipController=controller;
    }
    protected override void OnParametersSet()
    {
        if(!Equals(_previous,Value)) { _previous=Value; _text=Value?.Label ?? ""; }
        if(Disabled) Close();
    }
    private void Search()
    {
        var culture=Options.EffectiveCulture;
        _items=Items().Where(x=>x.Selectable && (string.IsNullOrWhiteSpace(_query) || culture.CompareInfo.IndexOf(x.Label,_query,CompareOptions.IgnoreCase)>=0))
            .OrderBy(x=>x.Label,StringComparer.Create(culture,true)).Take(50).ToArray();
        _active=-1;
    }
    private void Open() { if(Disabled) return; _query=""; _open=true; Search(); }
    private void Close() { _search?.Cancel(); _open=false; _query=""; _text=Value?.Label ?? ""; }
    private async Task InputAsync(ChangeEventArgs e)
    {
        if(Disabled) return;
        _text=e.Value?.ToString() ?? ""; _query=_text; _open=true;
        _search?.Cancel(); _search?.Dispose();
        var search=_search=new CancellationTokenSource();
        var token=search.Token;
        if(_text.Length==0 && Clearable) await ValueChanged.InvokeAsync(null);
        try { await Task.Delay(200,token); if(!_disposed && !Disabled) Search(); }
        catch(OperationCanceledException) { }
    }
    private async Task SelectAsync(ReferenceOption? item)
    {
        if(Disabled || item is null && !Clearable) return;
        _search?.Cancel(); _open=false; _query=""; _text=item?.Label ?? "";
        await ValueChanged.InvokeAsync(item);
    }
    private Task ClearAsync()=>SelectAsync(null);
    private async Task KeyDown(KeyboardEventArgs e)
    {
        if(Disabled) return;
        if(e.Key=="Escape" || e.Key=="Tab") Close();
        else if(e.Key is "ArrowDown" or "ArrowUp")
        {
            if(!_open) Open();
            if(_items.Length>0) _active=_active<0 ? (e.Key=="ArrowDown" ? 0 : _items.Length-1) : (_active+(e.Key=="ArrowDown" ? 1 : -1)+_items.Length)%_items.Length;
        }
        else if(e.Key=="Enter" && _open && _active>=0) await SelectAsync(_items[_active]);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed=true; _search?.Cancel(); _search?.Dispose();
        try
        {
            if(_tooltipController is not null)
            {
                await _tooltipController.InvokeVoidAsync("dispose");
                await _tooltipController.DisposeAsync();
            }
            if(_module is not null) await _module.DisposeAsync();
        }
        catch(JSDisconnectedException) { }
    }
}