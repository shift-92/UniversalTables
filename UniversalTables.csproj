<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UniversalTables</RootNamespace>
    <AssemblyName>UniversalTables</AssemblyName>
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
  </ItemGroup>
  <!-- UniversalTables verification exclusion -->
  <ItemGroup>
    <Compile Remove="Verification/**/*.cs" />
    <Content Remove="Verification/**" />
    <None Remove="Verification/**" />
    <EmbeddedResource Remove="Verification/**" />
  </ItemGroup>
</Project>